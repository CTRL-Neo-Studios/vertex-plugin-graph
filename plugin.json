{
  "id": "graph",
  "name": "Graph",
  "version": "0.1.0",
  "description": "Notes and the links between them as a graph: the whole workspace, or around the open note.",
  "icon": "i-lucide-waypoints",
  "author": "CTRL Neo Studios",
  "repository": "https://github.com/CTRL-Neo-Studios/vertex-plugin-graph",
  "apiVersion": 1,
  "config": {
    "overridable": {
      "showTags": "workspace",
      "showAttachments": "workspace",
      "showUnresolved": "workspace",
      "showOrphans": "workspace",
      "localDepth": "workspace",
      "groups": "workspace",
      "centerForce": "workspace",
      "repelForce": "workspace",
      "linkForce": "workspace",
      "linkDistance": "workspace"
    },
    "schema": [
      {"key": "showTags", "type": "switch", "label": "plugins.graph.config.showTags", "default": false},
      {"key": "showAttachments", "type": "switch", "label": "plugins.graph.config.showAttachments", "default": false},
      {"key": "showUnresolved", "type": "switch", "label": "plugins.graph.config.showUnresolved", "description": "plugins.graph.config.showUnresolvedHelp", "default": false},
      {"key": "showOrphans", "type": "switch", "label": "plugins.graph.config.showOrphans", "description": "plugins.graph.config.showOrphansHelp", "default": true},
      {"key": "localDepth", "type": "number", "label": "plugins.graph.config.localDepth", "description": "plugins.graph.config.localDepthHelp", "default": 1, "min": 1, "max": 5, "step": 1},
      {"key": "groups", "type": "list", "label": "plugins.graph.config.groups", "description": "plugins.graph.config.groupsHelp", "default": [], "placeholder": "tag:project #f59e0b"},
      {"key": "centerForce", "type": "number", "label": "plugins.graph.config.centerForce", "default": 0.05, "min": 0, "max": 1, "step": 0.01},
      {"key": "repelForce", "type": "number", "label": "plugins.graph.config.repelForce", "default": 120, "min": 0, "max": 1000, "step": 10},
      {"key": "linkForce", "type": "number", "label": "plugins.graph.config.linkForce", "default": 0.5, "min": 0, "max": 1, "step": 0.05},
      {"key": "linkDistance", "type": "number", "label": "plugins.graph.config.linkDistance", "default": 50, "min": 10, "max": 300, "step": 5}
    ]
  }
}
